                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filters\": {\n    \"member_id\": {\n      \"eq\": \"BR-PAT-SHG-000001-06\"\n    }\n  },\n  \"limit\": 5,\n  \"offset\": 0\n}"
            },
            "url": {
