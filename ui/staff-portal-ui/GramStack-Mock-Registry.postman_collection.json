    "_postman_id": "b35ac462-3210-45a8-94ff-2bc36be02582",
    "name": "GramStack Mock Registry - Search API",
    "description": "Search API examples (POST /api/v1/{Entity}/search) for all six GramStack mock registries running on Sunbird RC. One folder per registry, each with 2-3 example requests using real sample values from sunbirdrc2.0/data/*.json. Set the `base_url` collection variable (default http://localhost:8086) to point at your registry.\n\nSee sunbirdrc2.0/README.md and lookup.py for the equivalent Python helpers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://gramstack-mock-registry.credissuer.com",
      "type": "string"
    }
  ],
